{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep,
 ;; all .cljc → portable to JVM / SCI / ClojureScript / GraalVM).
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.1"} ; aozora publish + LLM json
        io.github.com-junkawasaki/langgraph-clj
        {:local/root "../../kotoba-lang/langgraph"}}
 :aliases
 {;; offline workspace dev — pin transitive langchain-clj to local checkout
  :dev {:override-deps
        {io.github.com-junkawasaki/langchain-clj
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run → drive one fact-check claim through the actor
  :run {:main-opts ["-m" "tashikame.sim"]}
  :test {:extra-paths ["test"]
         ;; kotoba-lang/amu is a TEST-ONLY dependency, for
         ;; tashikame.kotoba-parity-test: it compiles kotoba/*.kotoba in
         ;; process and binds publish-allowed / default-phase to their
         ;; tashikame.phase twins, and asserts kotoba/negative_eval.kotoba is
         ;; actually rejected. The actor itself has no runtime dependency on
         ;; the compiler — nothing under src/ requires it. The SHA is the
         ;; superproject's west pin for kotoba-lang/amu; it brings the KIR
         ;; interpreter (kotoba.kir) transitively via kotoba-lang/kotoba-kir.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "806f5cef7d5bc11ad8ec8514ad6121efc73be6c7"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
