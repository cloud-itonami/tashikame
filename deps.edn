{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep,
 ;; all .cljc → portable to JVM / SCI / ClojureScript / GraalVM).
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        ;; json.data-json is a data.json-shaped shim over json.core; pinned as
        ;; an explicit floor for the same reason as text above.
        io.github.kotoba-lang/json {:git/sha "4e33e06b4d66b365d27a51393a16a0acd660f9be"} ; aozora publish + LLM json
        io.github.com-junkawasaki/langgraph-clj
        {:local/root "../../kotoba-lang/langgraph"}}
 :aliases
 {;; This alias held an :override-deps entry for the retired coordinate
  ;; io.github.com-junkawasaki/langchain-clj. langgraph declares the same
  ;; library as io.github.kotoba-lang/langchain, so the entry matched no
  ;; node in the resolved tree and never reached the classpath -- verified
  ;; with `kbb -Stree`/-Spath, unchanged before and after removal.
  :dev {}
  ;; kbb -M:dev:run → drive one fact-check claim through the actor
  :run {:main-opts ["-m" "tashikame.sim"]}
  :test {:extra-paths ["test"]
         ;; kotoba-lang/amu is a TEST-ONLY dependency, for
         ;; tashikame.kotoba-parity-test: it compiles kotoba/*.kotoba in
         ;; process and binds publish-allowed / default-phase to their
         ;; tashikame.phase twins, and asserts kotoba/negative_eval.kotoba is
         ;; actually rejected. The actor itself has no runtime dependency on
         ;; the compiler — nothing under src/ requires it. The SHA is the
         ;; superproject's west pin for kotoba-lang/amu; it brings the KIR
         ;; interpreter (kotoba.kir) transitively via kotoba-lang/kotoba-kir.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "806f5cef7d5bc11ad8ec8514ad6121efc73be6c7"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
